<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Default version for local/dev builds; CI overrides via -p:Version=<tag> at publish. -->
    <Version>0.11.0</Version>
    <!--
      Single-file publish must self-extract ALL content (managed assemblies) to disk,
      not just native libs. The Knx.Falcon ApplicationData master-data loader derives its
      search directories from Assembly.Location, which is EMPTY for assemblies embedded in
      a single-file bundle (Path.Combine(null,...) -> DptFactory.Default throws -> every DPT
      decode falls back to hex). Extracting to disk gives a valid Assembly.Location.
      Only takes effect when PublishSingleFile=true; ignored otherwise.
    -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!--
      Quelle der Endpunkt-Beschreibungen in der API-Referenz (/scalar/v1): die
      XML-Doku-Kommentare der Controller. XmlDocumentationTransformer liest die hier
      erzeugte Datei ein. CS1591 aus: nicht jedes öffentliche Element braucht einen
      Kommentar, nur die Endpunkte — sonst rauscht der Build voll Warnungen.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!--
      Beim Build wird das OpenAPI-Dokument als Datei nach docs/api/ geschrieben, damit
      der API-Stand versioniert und im Diff sichtbar ist. Es ist ein reines Erzeugnis —
      niemand pflegt es von Hand, und es kann deshalb auch nicht vom Code abweichen.
    -->
    <!--
      Nur ohne RuntimeIdentifier: Der Generator startet die gebaute Anwendung, um das
      Dokument abzugreifen. Beim Release wird für fremde Plattformen übersetzt
      (linux-arm64 auf einem x64-Läufer) — dort lässt sie sich nicht ausführen und der
      Build bricht mit "cannot open libhostpolicy.so" ab. Das Dokument entsteht beim
      normalen Build und liegt ohnehin versioniert im Repo.
    -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <!--
      Ausdrücklich false, nicht bloß "nicht gesetzt": Bleibt die Eigenschaft leer,
      setzt das Paket seinen eigenen Vorgabewert true und der Generator läuft doch.
    -->
    <OpenApiGenerateDocuments Condition="'$(RuntimeIdentifier)' != ''">false</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../docs/api</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="9.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.17" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KnxMonitor.Core\KnxMonitor.Core.csproj" />
    <ProjectReference Include="..\KnxMonitor.Infrastructure\KnxMonitor.Infrastructure.csproj" />
    <ProjectReference Include="..\KnxMonitor.ProjectParser\KnxMonitor.ProjectParser.csproj" />
  </ItemGroup>

</Project>
